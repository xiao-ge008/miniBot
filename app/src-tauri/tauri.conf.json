{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "miniBot",
  "version": "0.1.18",
  "identifier": "com.minibot.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "launcher",
        "title": "miniBot · AI 聊天",
        "url": "index.html",
        "width": 1060,
        "height": 740,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "maximizable": false,
        "center": true,
        "visible": true
      }
    ],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "resources": ["prompts/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "icons/nsis-hooks.nsh",
        "languages": ["SimpChinese"],
        "installMode": "currentUser"
      }
    }
  }
}
